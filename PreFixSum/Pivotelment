class Solution {
public:
    int pivotIndex(vector<int>& nums) {
        vector<int>ps;
        int n=nums.size();
        for(int i=0;i<nums.size();i++)
        {
            if(i==0)
            ps.push_back(nums[i]);
            else
            ps.push_back(nums[i]+ps[i-1]);
        }
        int pindex=-1;
        for(int i=0;i<nums.size();i++)
        {
            if(i==0)
            {
               if((ps[n-1]-ps[i]==0))
               {
               pindex=0;
               break;
               }
            }
            else
            if((ps[i-1])==(ps[n-1]-ps[i]))
            {
            pindex=i;
            break;
            }
        }
        return pindex;
    }
};
